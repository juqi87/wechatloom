{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wechatloom.dev/schemas/components/wx-callout.schema.json",
  "title": "WeChatLoom callout component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "content"
  ],
  "properties": {
    "content": {
      "type": "string",
      "description": "Callout body",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "description": "Callout heading",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "description": "Semantic callout tone",
      "minLength": 1,
      "enum": [
        "info",
        "warning",
        "success",
        "neutral"
      ]
    }
  }
}
