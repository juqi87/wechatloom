{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wechatloom.dev/schemas/components/wx-metrics.schema.json",
  "title": "WeChatLoom metrics component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "description": "Metric tiles",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Metric label",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "description": "Metric value",
            "minLength": 1
          }
        }
      }
    },
    "title": {
      "type": "string",
      "description": "Metrics heading",
      "minLength": 1
    }
  }
}
